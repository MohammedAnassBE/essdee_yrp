iv>\\n                {% if doc.vehicle_no %}\\n                    <div class=\\\"row\\\" style=\\\"border-bottom:1px solid #ddd;\\\">\\n                        <div class=\\\"col-xs-5 text-right\\\" style=\\\" padding-right: 4px; padding-left:0px;\\\"><small>Vehicle No:</small></div>\\n                        <div class=\\\"col-xs-7\\\" style=\\\"padding-left:0px;\\\"><strong>{{ doc.vehicle_no }}</strong></div>\\n                    </div>\\n                {% endif %}    \\n            </div>\\n        </div>\\n        <div class=\\\"row\\\" style=\\\"border-bottom:1px solid #666;\\\">\\n            <div class=\\\"col-xs-12 text-center\\\">Particulars</div>\\n        </div>\\n        <div class=\\\"row\\\">\\n            {% set item_details = fetch_stock_entry_items(doc.items) %}\\n            <table class=\\\"table table-sm table-bordered\\\">\\n                {% for i in item_details %}\\n                <tr>\\n                    {% if i.primary_attribute %}\\n                    <td>\\n                        <table class=\\\"table table-sm table-bordered\\\">\\n                            <tr>\\n                                <th width=\\\"25\\\">S.No.</th>\\n                                <th>Item</th>\\n                                <th>Lot</th>\\n                                {% for attr in i['attributes'] %}\\n                                    <th>{{ attr }}</th>\\n                                {% endfor %}\\n                                {% for attr in i['primary_attribute_values'] %}\\n                                    <th>{{ attr }}</th>\\n                                {% endfor %}\\n                                <th>Total</th>\\n                            </tr>\\n                            {% for j in i['items'] %}\\n                            <tr>\\n                                <td>{{ loop.index }}</td>\\n                                <td>{{ j.name }}</td>\\n                                <td>{{ j.lot }}</td>\\n                                {% for attr in i['attributes'] %}\\n                                <td>\\n                                    {% if attr in j.attributes %}\\n                                        {{ j.attributes[attr] }}\\n                                    {% endif %}\\n                                </td>\\n                                {% endfor %}\\n                                {% set total = {\\\"total\\\": 0} %}\\n                                {% for attr in j['values'] %}\\n                                    <td>\\n                                        {% if j['values'][attr].qty %}\\n                                            {% set _ = total.update({\\\"total\\\": total['total'] + j['values'][attr].qty}) %}\\n                                            <div>\\n                                                {{ j['values'][attr].qty }}{% if j.default_uom %}{{' ' + j.default_uom}}{% endif %}\\n                                            </div>\\n                                        {% else %}\\n                                            <div class=\\\"text-center\\\">\\n                                                ---\\n                                            </div>\\n                                        {% endif %}\\n                                    </td>\\n                                {% endfor %}\\n                                <td>{{ total['total'] }}</td>\\n                            </tr>\\n                            {% endfor %}\\n                        </table>\\n                    </td>\\n                    {% else %}\\n                    <td>\\n                        <table class=\\\"table table-sm table-bordered\\\">\\n                            <tr>\\n                                <th width=\\\"25\\\">S.No.</th>\\n                                <th>Item</th>\\n                                <th>Lot</th>\\n                                {% for attr in i.attributes %}\\n                                    <th>{{ attr }}</th>\\n                                {% endfor %}\\n                                <th>Quantity</th>\\n                                <!-- <th>Rate</th> -->\\n                            </tr>\\n                            {% for j in i['items'] %}\\n                            <tr>\\n                                <td>{{ loop.index }}</td>\\n                                <td>{{ j.name }}</td>\\n                                <td>{{ j.lot }}</td>\\n                                {% for attr in i['attributes'] %}\\n                                    <td>{{ j.attributes[attr] }}</td>\\n                                {% endfor %}\\n                                <td>\\n                                    {{ j['values']['default'].qty }}{% if j.default_uom %}{{' ' + j.default_uom}}{% endif %}\\n                                </td>\\n                                <!-- <td>\\n                                    {{ frappe.utils.fmt_money(j['values']['default'].rate, currency=\\\"\\u20b9\\\") }}\\n                                </td> -->\\n                            </tr>\\n                            {% endfor %}\\n                        </table>\\n                    </td>\\n                    {% endif %}\\n                </tr>\\n                {% endfor %}\\n            </table>\\n        </div>\\n        <div class=\\\"row\\\" style=\\\"border-bottom:1px solid #666;border-top:1px solid #666;\\\">\\n            <div class=\\\"col-xs-12\\\">Estimated Value: {{ frappe.utils.fmt_money(doc.total_amount, currency=\\\"\\u20b9\\\") }}</div>\\n        </div>\\n        {% if doc.terms_and_condition %}\\n            {% set terms = frappe.get_all(\\\"YRP Terms and Condition Detail\\\", filters={\\\"parent\\\": doc.terms_and_condition, \\\"parenttype\\\": \\\"YRP Terms and Condition\\\"}, fields=[\\\"term\\\"], order_by=\\\"idx asc\\\") %}\\n            {% if terms %}\\n                <div class=\\\"row\\\" style=\\\"border-bottom:1px solid #666;\\\">\\n                    <div class=\\\"col-xs-12\\\">\\n                        <strong>Terms and Conditions:</strong>\\n                        <ol style=\\\"margin:4px 0 4px 18px;padding:0;\\\">\\n                            {% for row in terms %}\\n                                <li style=\\\"margin-bottom:2px;\\\">{{ row.term }}</li>\\n                            {% endfor %}\\n                        </ol>\\n                    </div>\\n                </div>\\n            {% endif %}\\n        {% endif %}\\n        <div class=\\\"row\\\">\\n            {% set company = frappe.db.get_single_value(\\\"SD YRP Company Settings\\\", \\\"company\\\") %}\\n            <div class=\\\"col-xs-6 text-center\\\" style=\\\"border-right:1px solid #666;\\\">\\n                Receiver's Signature\\n                <br>\\n                <br>\\n                <br>\\n                <div class=\\\"row text-left\\\">\\n                    <div class=\\\"col-xs-6\\\">\\n                        Name:\\n                    </div>\\n                    <div class=\\\"col-xs-6\\\">\\n                        Designation:\\n                    </div>\\n                </div>\\n            </div>\\n            <div class=\\\"col-xs-6 text-right\\\">\\n                <small>For </small>\\n                <strong>{{ company  }}</strong>\\n                <br>\\n                <br>\\n                <br>\\n                Authorized Signatory\\n                <!-- {% set signature = get_user_signature(doc.approved_by) %}\\n                {% if signature %}\\n                <div>\\n                    <img src={{signature}} style=\\\"height: 50px;\\\">\\n                    <br>Authorized Signatory\\n                </div>\\n                {% else %} -->\\n                <!-- {% endif %} -->\\n            </div>\\n        </div>\\n    </div>\\n    {% endif %}\\n</div>\"}]",
